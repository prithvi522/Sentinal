# Optional external-service configuration. Copy this file to backend/.env.
# Leave values blank to use local/demo functionality without external providers.

# CHATGPT_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-04-01-preview

# VIRUSTOTAL_API_KEY=
# THREATFOX_API_KEY=
# ABUSEIPDB_API_KEY=
# SHODAN_API_KEY=

# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3

# Development defaults are already built in. Override only when needed.
# DATABASE_URL=sqlite:///./dev.db
# JWT_SECRET=replace-with-a-long-random-value-before-production

# SIH26145 passive data-diode defense
UNIDIRECTIONAL_ENABLED=true
UNIDIRECTIONAL_QUEUE_SIZE=1000
UNIDIRECTIONAL_WORKERS=1
UNIDIRECTIONAL_BENCHMARK_ENABLED=true
UNIDIRECTIONAL_REPLAY_SPEED=1.0
MAX_PCAP_SIZE_BYTES=262144000
# Comma-separated capture interfaces dedicated to the TAP/data-diode feed.
# Leave blank only for local development; production should explicitly allow-list the ingest NIC.
UNIDIRECTIONAL_ALLOWED_INTERFACES=
UNIDIRECTIONAL_LIVE_EMIT_INTERVAL_SECONDS=1.0
# Define monitored-network CIDRs before enabling exfiltration direction analysis.
UNIDIRECTIONAL_PROTECTED_CIDRS=
